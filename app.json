{
  "expo": {
    "name": "pmob-react-native-labs",
    "slug": "pmob-react-native-labs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "com.natatama.pmobreactnativelabs",
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.natatama.pmobreactnativelabs"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.natatama.pmobreactnativelabs"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ]
    ]
  }
}
